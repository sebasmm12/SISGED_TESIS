
<li class="li-tool li-drag-style @ToolColor">
    <div class="tool-container">
        <MudIcon Icon="@Item.Icon" Size="Size.Medium"></MudIcon>
        <div class="tool-sub-container">
            <p class="tool-name">@Item.Name</p>
            @if (Item.Client is not null)
            {
                var dossierTray = (DossierTrayResponse)Item.Value;
                @if (IsToolTipVisible())
                {
                    <MudTooltip Arrow="true" Delay="200" Placement="@GetPlacement()" RootClass="tool-tooltip">
                        <ChildContent>
                            <p class="tool-title">@GetDocumentTitle(dossierTray)</p>
                        </ChildContent>
                        <TooltipContent>
                            <MudText Typo="Typo.body2">
                                @DocumentTitle
                            </MudText>
                        </TooltipContent>
                    </MudTooltip>
                }
                else
                {
                    <p class="tool-title">@GetDocumentTitle(dossierTray)</p>
                }

                <p class="tool-description">@DocumentTypeMapper.Map(Item.Description)</p>
            }
            
            @if (Item.Client is not null)
            {
                <p class="tool-client-name">@Item.Client.GetShortName() - @Item.Client.DocumentNumber</p>
                var dossierTray = (DossierTrayResponse)Item.Value;
                if (accepetedStatusToDocument.Contains(Item.ItemStatus) && Item.OriginPlace.Equals("inputs"))
                {
                    <p class="registro">Documento Registrado: @dossierTray.Document!.Type</p>
                }
                if (acceptedStatusToPublicDeed.Contains(Item.ItemStatus) && Item.OriginPlace.Equals("inputs"))
                {
                    <p class="registro">Escritura Pública escogida: @Item.PublicDeed!.Title</p>
                }
                if (acceptedStatusToInfo.Contains(dossierTray.Document!.State) && Item.CurrentPlace.Equals("workplace"))
                {
                    <div class="field-container">
                        @if (!string.IsNullOrEmpty(GetDocumentGeneratedUrl(dossierTray)))
                        {
                            <MudItem xs="12" sm="12" md="12" lg="12" xl="12">
                                <div class="text-start text-sm-center mb-2">
                                    <MudTooltip Text="Ver Documento" Arrow="true" Placement="Placement.Top">
                                        <MudIconButton Icon="fas fa-file-pdf" Color="Color.Error" Href="@DocumentGeneratedUrl" Target="_blank"
                                                       Class="rounded-circle"></MudIconButton>
                                    </MudTooltip>
                                </div>
                            </MudItem>
                        }
                        else
                        {
                            <MudItem xs="12" sm="12" md="12" lg="12" xl="12">
                                <div class="text-start text-sm-center mb-2">
                                    <MudTooltip Text="Ver Información del documento" Arrow="true" Placement="Placement.Top">
                                        <MudIconButton Icon="fas fa-info" Color="Color.Info" OnClick="@(() => ShowDocumentInfoAsync(dossierTray))"
                                                       Class="rounded-circle"></MudIconButton>
                                    </MudTooltip>
                                </div>
                            </MudItem>
                        }
                        @if (Item.ItemStatus.Equals("evaluated"))
                        {
                            <MudButton Class="mud-info-c">Ver Evaluación</MudButton>
                        }
                    </div>
                }

                if (PublicDeed is not null)
                {
                    if (acceptedDocumentTypes.Contains(dossierTray.Document!.Type))
                    {
                        <div class="field-container">
                            <a class="mud-info-c p-2" href="@PublicDeed.Url" target="_blank">Ver Escritura Pública</a>
                        </div>
                    }
                }

            }
        </div>
    </div>
</li>


