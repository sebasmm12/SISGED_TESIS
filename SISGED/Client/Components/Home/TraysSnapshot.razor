<MudCard Elevation="5" Class="trays-snapshot">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">Bandejas del usuario</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" sm="12" md="6" lg="6" xl="6">
                <Snapshot Title="Entrada" Quantity="5" Icon="fa-arrow-trend-up" Color="Color.Success" BackgroundColor="@Colors.Green.Lighten4"></Snapshot>
            </MudItem>
            <MudItem xs="12" sm="12" md="6" lg="6" xl="6">
                <Snapshot Title="Salida" Quantity="6" Icon="fa-arrow-trend-down" Color="Color.Error" BackgroundColor="@Colors.Red.Lighten4"></Snapshot>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>