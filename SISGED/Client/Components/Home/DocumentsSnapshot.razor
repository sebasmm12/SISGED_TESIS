<MudCard Elevation="5" Class="documents-snapshot">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">Proceso de documentos</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @if (isRendered)
        {
            <MudGrid>
                <MudItem xs="12" sm="12" md="4" lg="4" xl="4">
                    <Snapshot Title="Registrados" Quantity="@documentSnapshotResponse!.Registered" Icon="fa-file-circle-plus" Color="@Colors.Blue.Default" BackgroundColor="@Colors.Blue.Lighten4"></Snapshot>
                </MudItem>
                <MudItem xs="12" sm="12" md="4" lg="4" xl="4">
                    <Snapshot Title="Derivados" Quantity="@documentSnapshotResponse!.Derived" Icon="fa-file-import" Color="@Colors.Amber.Lighten1" BackgroundColor="@Colors.Yellow.Lighten4"></Snapshot>
                </MudItem>
                <MudItem xs="12" sm="12" md="4" lg="4" xl="4">
                    <Snapshot Title="Retrasados" Quantity="@documentSnapshotResponse!.Expired" Icon="fa-file-circle-exclamation" Color="@Colors.Orange.Default" BackgroundColor="@Colors.Orange.Lighten4"></Snapshot>
                </MudItem>
            </MudGrid>
        }
    </MudCardContent>
</MudCard>