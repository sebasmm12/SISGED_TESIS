<MudGrid class="snapshot">
    <MudItem>
        <MudAvatar Style="@($"background-color: { BackgroundColor }")" Size="Size.Large">
            <MudIcon Icon="@($"fas {Icon}")" Color="@Color"></MudIcon>
        </MudAvatar>
    </MudItem>
    <MudItem>
        <MudText class="snapshot-quantity" Typo="Typo.h5">@Quantity</MudText>
        <MudText class="snapshot-title" Typo="Typo.subtitle1">@Title</MudText>
    </MudItem>
</MudGrid>